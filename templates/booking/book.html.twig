{% extends 'base.html.twig' %}

{% block title %}Book seats · {{ parent() }}{% endblock %}

{% block body %}
    <h1>Book seats</h1>
    {% if filler_available %}
        <p class="lede">
            Got the request by email?
            <a href="{{ path('form_bridge_fill', {tool: 'create_booking', text: example_email}) }}">Paste the message and the form is filled in for you</a>.
            {% if example_email %}Offline mode: only the example message is understood.{% endif %}
        </p>
    {% endif %}

    {{ form_start(form, {attr: {class: 'booking', novalidate: 'novalidate'}}) }}
        {{ form_errors(form) }}
        {{ form_rest(form) }}
        <button type="submit" class="button">Book</button>
    {{ form_end(form, {render_rest: false}) }}
{% endblock %}
